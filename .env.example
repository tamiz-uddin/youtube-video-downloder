# ==============================================================================
# VidLoader Studio — Environment Configuration Example
# Copy this file to .env and adjust variables for your deployment
# ==============================================================================

# Server Network Settings
PORT=3333
HOST=0.0.0.0
NODE_ENV=production

# Security & CORS (Use comma-separated origins in production, e.g., https://yourdomain.com)
CORS_ORIGIN=*

# Concurrency & Resource Limits (Default: 3 simultaneous active downloads)
MAX_CONCURRENT_DOWNLOADS=3

# Optional: Outbound Proxy for YouTube / Social Media IP Unblocking
# Useful if hosting on cloud VPS providers (AWS, DigitalOcean, Hetzner, GCP) where IPs are rate-limited
# PROXY_URL=http://username:password@proxy-host.com:8080
